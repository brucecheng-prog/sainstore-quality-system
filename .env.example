HOST_PORT=8501
TZ=Asia/Shanghai
FORCE_PRODUCTION=1
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8501
PHOTO_API_BASE=http://YOUR_SERVER_IP:8800
ALLOWED_DOMAINS=sainstore.com
COOKIE_SECRET=

# 可选：如果服务器上要自定义 Logo 路径，填绝对路径；否则留空用项目内 logo.png
COMPANY_LOGO_PATH=

# 可选：仅本地开发额外分析页使用，Linux 服务器一般留空
LOCAL_ANALYTICS_DIR=

# 如不填写，程序会继续使用当前代码里的默认值
NAS_URL=
NAS_ACCOUNT=
NAS_PASSWORD=
NAS_BASE_PATH=
NAS_STAGING_PATH=

# 如不填写，程序会继续读取 data/client_secret.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 可选：覆盖代码里默认配置的品质系统钉钉应用推送凭证
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
